# ============================================================
#  DRC-CL — .gitignore
# ============================================================

# ---- Data: raw datasets are NEVER committed (DGArchive license) ----
data/raw/
data/interim/
*.parquet

# ---- data/processed/: block by default, then re-include only the
#      small reproducibility artifacts (Git needs each parent dir
#      un-ignored before a nested file can be whitelisted) ----
data/processed/*
!data/processed/benchmark/
data/processed/benchmark/*
!data/processed/benchmark/drift_labels.json
!data/processed/benchmark/integrity_report.txt
!data/processed/benchmark/family_coverage.csv
!data/processed/benchmark/benchmark_manifest.csv
!data/processed/benchmark/*.sha256
# (the heavy window CSVs D*.csv and splits/ stay excluded by the
#  "data/processed/benchmark/*" line above — they are raw domains)

# ---- Model checkpoints & large binaries ----
results/checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx

# ---- Fabricated CD-diagram artifacts (do NOT redistribute) ----
results/cd_diagram_*.png
results/cd_diagram_*.pdf

# ---- Logs ----
results/logs/
*.log

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Jupyter ----
notebooks/*.ipynb_checkpoints/
